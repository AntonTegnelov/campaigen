{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "campaigen",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/campaigen",
  "remoteUser": "dev",

  // Keep the sshd entrypoint running so SSH access works while VS Code is
  // attached via the Dev Containers extension.
  "overrideCommand": false,

  // NOTE: no "forwardPorts" here. Zed's dev container support translates it
  // into an extra docker-published host port, which collides with the compose
  // file's 2236:22 mapping and makes the container fail to start.

  "postCreateCommand": "dotnet restore Campaigen.sln",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "anthropic.claude-code"
      ]
    }
  }
}
